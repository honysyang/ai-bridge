# AI 智能体桥接器 (ai-bridge) 环境变量示例
# 复制为 .env 后按需修改，未设置项使用默认值

# ==================== 基础服务 ====================
# 服务端口（默认 4567）
PORT=4567

# 运行环境：development | production
NODE_ENV=production

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ==================== 安全 ====================
# JWT 签名密钥（至少 32 字符）。留空则首次启动自动生成并写入 secrets.env
# 生产环境建议设置固定强密钥，避免重启后所有用户需要重新登录
AIBRIDGE_JWT_SECRET=

# 数据目录（默认 process.cwd()/data）
# 设置后所有 JSONL/SQLite 文件会存放到该目录
AIBRIDGE_DATA_DIR=

# 请求体大小限制（默认 10mb）
AIBRIDGE_BODY_LIMIT=10mb

# 信任的反向代理列表（逗号分隔）
# 默认值：loopback,linklocal,uniquelocal
# 公网部署时请改为你的反向代理 IP 或 CIDR，例如：
# AIBRIDGE_TRUSTED_PROXIES=10.0.0.1,172.16.0.0/12
AIBRIDGE_TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# 本地放行网段（逗号分隔，默认 127.0.0.1,::1）
# 配置后这些网段访问 /api/* 可自动免登录
# 注意：必须确保这些网段不可从公网到达，否则会有未授权访问风险
# AIBRIDGE_LOCAL_NETWORKS=127.0.0.1,::1,192.168.0.0/16,10.0.0.0/8
AIBRIDGE_LOCAL_NETWORKS=127.0.0.1,::1

# CORS 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:4567,http://127.0.0.1:4567

# ==================== 数据持久化 ====================
# SQLite 同步开关（1=启用，0=禁用）
AIBRIDGE_SQLITE_SYNC=1

# ==================== 微信 iLink（可选） ====================
# iLink App ID
ILINK_APP_ID=

# iLink Bot Token
ILINK_BOT_TOKEN=

# iLink Bot Agent（UA 风格标识）
ILINK_BOT_AGENT=AiBridge/5.5.5
