{
  "name": "ai-bridge",
  "version": "5.5.5",
  "description": "AI 智能体桥接器：Trae IDE / 微信 ClawBot 与 AI 智能体之间的通用中间层",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "predev": "bash scripts/predev.sh 4567",
    "dev": "tsx src/index.ts",
    "prestart": "npm run build",
    "test": "vitest run",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"public/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"public/**/*.{js,css,html}\"",
    "sqlite:migrate": "tsx src/lib/sqlite-migrate.ts",
    "sqlite:status": "tsx -e \"import {sqliteStore} from './src/lib/sqlite-store.js'; console.log(JSON.stringify({tables: sqliteStore.getTableCounts(), file_size: sqliteStore.getDbFileSize()}, null, 2)); sqliteStore.close();\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "express": "^4.21.0",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/winston": "^2.4.4",
    "@types/ws": "^8.5.0",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "weixin",
    "ilink",
    "clawbot",
    "agent",
    "task-queue",
    "heartbeat"
  ],
  "author": "",
  "license": "MIT"
}
